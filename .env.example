# Synthetos environment template.
#
#   cp .env.example .env
#   # fill in the LLM keys you want active, then:
#   docker compose up -d

# ---------- LLM credentials ----------
# Required for the operators that call the matching provider. Empty values
# are fine; affected operators error at call time, the rest of the stack
# still boots.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---------- Optional overrides ----------
# Defaults live in libs/core/config.py and are sensible for the compose
# stack. Uncomment only what you actually need to override.

# LAB_ENV=prod
# LAB_DATA_ROOT=/data
# LAB_API_PORT=8000

# Local LLM gateway (LMStudio / Ollama / vLLM). The `local` provider in
# configs/models.yaml expects an OpenAI-compatible endpoint.
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# Override the model routing config (defaults to configs/models.yaml).
# LAB_MODEL_CONFIG=configs/models.yaml

# Skill discovery roots (colon-separated).
# LAB_SKILL_PATHS=skills:my-extra-skills
